# Plantilla del .env local para la capacidad de IA (parte 4 de la entrega final).
#
#   cp ejemplo.env .env     y poner la clave en .env
#
# .env está en .gitignore: la clave vive SOLO en la máquina. No va al repositorio
# ni a los secretos de GitHub, porque el pipeline no llama al modelo: el
# diagnóstico se corre a mano sobre los artefactos que el pipeline ya publicó.
#
# Sin clave, el diagnóstico corre igual con los backends que no usan IA:
#   python -m herramientas.diagnostico_ia --run <carpeta> --modelo lineabase
#   python -m herramientas.diagnostico_ia --run <carpeta> --modelo grabado

# Backend --modelo anthropic
ANTHROPIC_API_KEY=
# Opcional. Por defecto: claude-opus-5-5
MODELO_ANTHROPIC=

# Backend --modelo google
GOOGLE_API_KEY=
# Opcional. Por defecto: gemini-2.5-flash
MODELO_GOOGLE=
