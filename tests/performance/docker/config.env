# Configuración común de preparar.sh, correr.sh y los monitores (se carga con `source`).
# Cada valor se puede sobrescribir desde el entorno; por ejemplo, la escalabilidad opcional del diseño
# (§10.2, Opc. 1) es `CPUS=2 TOP=… ./correr.sh estres`.

: "${PUERTO:=8090}"              # puerto del host. Tarea: 8090; nunca el 8000 (demo del alumno) ni el 8443 (Kiwi)
: "${PUERTO_INTERNO:=8090}"      # puerto de uvicorn dentro del contenedor (CMD del Dockerfile)
: "${CONTENEDOR:=qolqe-perf}"    # contenedor de Qolqe que se mide (diseño §10.1)
: "${IMAGEN:=qolqe-perf:p3}"     # imagen construida con docker/Dockerfile (diseño §10.1)
: "${VOLUMEN:=qolqe-perf-datos}" # volumen con nombre para /data: qolqe.db, plantilla y base_perf.db (§6.1)
: "${CPUS:=1}"                   # cuota de CPU de Qolqe al medir: entorno Docker --cpus=1 (§6.1)
: "${MEMORIA:=1g}"               # --memory y --memory-swap iguales: límite estricto de 1 GB (§6.1)
: "${CPUS_PREPARACION:=4}"       # la preparación de datos no se mide, así que usa más CPU (§5.2)
: "${N_USUARIOS:=3000}"          # M-16: un usuario por VU = maxVUs del escenario más grande (estrés)
: "${HILOS_PREPARACION:=6}"      # clientes en paralelo al preparar (§5.2: el registro y el login escalan con CPU)
: "${CARGA_MAX:=1.5}"            # V-04: carga promedio de 1 min del equipo para empezar una corrida
: "${ESPERA_MAX:=900}"           # V-04: segundos que correr.sh espera a que el equipo se libere
: "${BASE_URL:=http://127.0.0.1:${PUERTO}}"

# Los scripts de Python (preparar_datos.py, verificar.py, corrida.py) leen estos valores del entorno.
export PUERTO CONTENEDOR IMAGEN VOLUMEN CPUS MEMORIA CPUS_PREPARACION BASE_URL
